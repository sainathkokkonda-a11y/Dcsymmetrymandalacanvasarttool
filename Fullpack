<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Symmetry & Mandala Canvas Art Tool</title>
    <style>
        :root {
            --primary-color: #1a73e8;
            --primary-dark: #1557b0;
            --bg-color: #f8f9fa;
            --card-bg: #ffffff;
            --text-color: #202124;
            --border-color: #dadce0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .app-container {
            background: var(--card-bg);
            width: 100%;
            max-width: 680px;
            border-radius: 5px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1.5px solid var(--border-color);
        }

        .app-header {
            background-color: var(--primary-color);
            color: white;
            padding: 20px;
            text-align: center;
        }

        .app-header h1 {
            margin: 0 0 5px 0;
            font-size: 22px;
        }

        .app-header p {
            margin: 0;
            font-size: 13px;
            opacity: 0.9;
        }

        .controls-section {
            padding: 15px 20px;
            display: grid;
            gap: 12px;
        }

        .control-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        @media (max-width: 500px) {
            .control-row {
                grid-template-columns: 1fr;
            }
        }

        .control-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 12px;
            font-weight: 600;
            color: var(--primary-dark);
        }

        select, input[type="color"], button {
            padding: 10px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 14px;
            background: #fff;
            outline: none;
            transition: all 0.2s;
        }

        select:focus, button:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 2px rgba(26, 115, 232, 0.2);
        }

        .range-container {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #fff;
            border: 1px solid var(--border-color);
            padding: 6px 10px;
            border-radius: 6px;
        }

        input[type="range"] {
            flex: 1;
            cursor: pointer;
        }

        .canvas-container {
            display: flex;
            justify-content: center;
            padding: 10px 20px;
            background: #f1f3f4;
        }

        canvas {
            background: #000;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            cursor: crosshair;
            max-width: 100%;
            height: auto;
            touch-action: none;
        }

        .actions-row {
            padding: 15px 20px 20px 20px;
            display: grid;
            grid-template-columns: 1fr 1fr 1.5fr;
            gap: 10px;
        }

        .btn {
            padding: 10px 15px;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            color: white;
            text-align: center;
            font-size: 13px;
        }

        .btn-undo { background-color: #5f6368; }
        .btn-undo:hover { background-color: #484c50; }

        .btn-clear { background-color: #d93025; }
        .btn-clear:hover { background-color: #b31412; }

        .btn-download { background-color: #188038; }
        .btn-download:hover { background-color: #137333; }
    </style>
</head>
<body>

<div class="app-container">
    <div class="app-header">
        <h1>Symmetry & Mandala Canvas Art Tool</h1>
        <p>Create, Design, and Export High-Resolution Radial Symmetry Artwork</p>
    </div>

    <div class="controls-section">
        <div class="control-row">
            <div class="control-group">
                <label>1. Drawing Effect / Line Style</label>
                <select id="lineStyle">
                    <option value="normal">Normal Solid Line</option>
                    <option value="dotted">Dotted Line</option>
                    <option value="dashed">Dashed Line</option>
                    <option value="double">Double Parallel Line</option>
                </select>
            </div>
            <div class="control-group">
                <label>2. Symmetry Points</label>
                <select id="symmetryPoints">
                    <option value="2">2 Points Symmetry</option>
                    <option value="4">4 Points Symmetry</option>
                    <option value="6">6 Points Symmetry</option>
                    <option value="8" selected>8 Points Symmetry</option>
                    <option value="12">12 Points Symmetry</option>
                    <option value="16">16 Points Symmetry</option>
                    <option value="24">24 Points Symmetry</option>
                    <option value="32">32 Points Symmetry</option>
                </select>
            </div>
        </div>

        <div class="control-row">
            <div class="control-group">
                <label>3. Color Mode & Neon Effects</label>
                <select id="colorMode">
                    <option value="solid">Custom Solid Color</option>
                    <option value="neon">Neon Glow Effect</option>
                    <option value="rainbow">Dynamic Rainbow Flow</option>
                </select>
            </div>
            <div class="control-group" id="solidColorGroup">
                <label>Pick Brush Color</label>
                <input type="color" id="brushColor" value="#00e5ff">
            </div>
        </div>

        <div class="control-row">
            <div class="control-group">
                <label>4. Canvas Theme</label>
                <select id="canvasTheme">
                    <option value="#000000">Black Theme</option>
                    <option value="#ffffff">White Theme</option>
                    <option value="#111f36">Deep Blue Theme</option>
                    <option value="#1e1e1e">Dark Gray Theme</option>
                </select>
            </div>
            <div class="control-group">
                <label>5. Export Resolution</label>
                <select id="exportResolution">
                    <option value="800">Standard Resolution (800 px)</option>
                    <option value="1920">Full HD (1920 px)</option>
                    <option value="2560">2K Resolution (2560 px)</option>
                    <option value="3840" selected>4K Ultra HD (3840 px)</option>
                    <option value="7680">8K Ultra HD (7680 px)</option>
                </select>
            </div>
        </div>

        <div class="control-row">
            <div class="control-group full-width" style="grid-column: span 2;">
                <label>Brush Thickness (<span id="sizeVal">3</span>px)</label>
                <div class="range-container">
                    <input type="range" id="brushSize" min="1" max="40" value="3">
                </div>
            </div>
        </div>
    </div>

    <div class="canvas-container">
        <canvas id="artCanvas" width="450" height="450"></canvas>
    </div>

    <div class="actions-row">
        <button class="btn btn-undo" id="undoBtn">Undo</button>
        <button class="btn btn-clear" id="clearBtn">Clear Canvas</button>
        <button class="btn btn-download" id="downloadBtn">Download Artwork</button>
    </div>
</div>

<script>
    const canvas = document.getElementById('artCanvas');
    const ctx = canvas.getContext('2d');
    
    const PREVIEW_SIZE = 450;
    let isDrawing = false;
    let strokePaths = [];
    let rainbowHue = 0;
    
    const brushColorInput = document.getElementById('brushColor');
    const colorModeSelect = document.getElementById('colorMode');
    const solidColorGroup = document.getElementById('solidColorGroup');
    const brushSizeInput = document.getElementById('brushSize');
    const sizeVal = document.getElementById('sizeVal');
    const symmetryPointsSelect = document.getElementById('symmetryPoints');
    const canvasThemeSelect = document.getElementById('canvasTheme');
    const lineStyleSelect = document.getElementById('lineStyle');
    const exportResolutionSelect = document.getElementById('exportResolution');
    
    const undoBtn = document.getElementById('undoBtn');
    const clearBtn = document.getElementById('clearBtn');
    const downloadBtn = document.getElementById('downloadBtn');

    function initCanvas() {
        ctx.fillStyle = canvasThemeSelect.value;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        strokePaths = [];
    }

    colorModeSelect.addEventListener('change', () => {
        if (colorModeSelect.value === 'solid') {
            solidColorGroup.style.display = 'flex';
        } else {
            solidColorGroup.style.display = 'none';
        }
    });

    canvasThemeSelect.addEventListener('change', () => {
        redrawCanvas();
    });

    brushSizeInput.addEventListener('input', (e) => {
        sizeVal.textContent = e.target.value;
    });

    function getMousePos(e) {
        const rect = canvas.getBoundingClientRect();
        const clientX = e.clientX || (e.touches ? e.touches[0].clientX : 0);
        const clientY = e.clientY || (e.touches ? e.touches[0].clientY : 0);
        
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;

        return {
            x: (clientX - rect.left) * scaleX,
            y: (clientY - rect.top) * scaleY
        };
    }

    let lastX = 0, lastY = 0;

    function startDraw(e) {
        isDrawing = true;
        const pos = getMousePos(e);
        lastX = pos.x;
        lastY = pos.y;
    }

    function draw(e) {
        if (!isDrawing) return;
        const pos = getMousePos(e);
        const currentX = pos.x;
        const currentY = pos.y;

        let strokeColor = brushColorInput.value;
        const colorMode = colorModeSelect.value;

        if (colorMode === 'rainbow') {
            rainbowHue = (rainbowHue + 4) % 360;
            strokeColor = `hsl(${rainbowHue}, 100%, 50%)`;
        } else if (colorMode === 'neon') {
            strokeColor = '#00ffff'; // Bright cyan neon standard
        }

        const strokeData = {
            x1: lastX, y1: lastY,
            x2: currentX, y2: currentY,
            color: strokeColor,
            colorMode: colorMode,
            size: parseInt(brushSizeInput.value),
            symmetry: parseInt(symmetryPointsSelect.value),
            lineStyle: lineStyleSelect.value
        };

        strokePaths.push(strokeData);
        renderStroke(ctx, strokeData, PREVIEW_SIZE);

        lastX = currentX;
        lastY = currentY;
    }

    function renderStroke(targetCtx, stroke, canvasSize) {
        const scale = canvasSize / PREVIEW_SIZE;
        const cx = canvasSize / 2;
        const cy = canvasSize / 2;
        const angleStep = (Math.PI * 2) / stroke.symmetry;

        targetCtx.strokeStyle = stroke.color;
        targetCtx.lineWidth = stroke.size * scale;
        targetCtx.lineCap = 'round';
        targetCtx.lineJoin = 'round';
        targetCtx.setLineDash([]);

        const scaledSize = stroke.size * scale;
        if (stroke.lineStyle === 'dotted') {
            targetCtx.setLineDash([scaledSize * 1.5, scaledSize * 1.5]);
        } else if (stroke.lineStyle === 'dashed') {
            targetCtx.setLineDash([scaledSize * 4, scaledSize * 2]);
        }

        // Neon Glow Setup
        if (stroke.colorMode === 'neon') {
            targetCtx.shadowColor = stroke.color;
            targetCtx.shadowBlur = scaledSize * 4;
        } else {
            targetCtx.shadowBlur = 0;
        }

        const x1_offset = (stroke.x1 * scale) - cx;
        const y1_offset = (stroke.y1 * scale) - cy;
        const x2_offset = (stroke.x2 * scale) - cx;
        const y2_offset = (stroke.y2 * scale) - cy;

        targetCtx.save();
        targetCtx.translate(cx, cy);

        for (let i = 0; i < stroke.symmetry; i++) {
            targetCtx.save();
            targetCtx.rotate(i * angleStep);
            
            // Main stroke
            targetCtx.beginPath();
            targetCtx.moveTo(x1_offset, y1_offset);
            targetCtx.lineTo(x2_offset, y2_offset);
            targetCtx.stroke();

            // Double line effect
            if (stroke.lineStyle === 'double') {
                targetCtx.beginPath();
                targetCtx.moveTo(x1_offset + scaledSize, y1_offset + scaledSize);
                targetCtx.lineTo(x2_offset + scaledSize, y2_offset + scaledSize);
                targetCtx.stroke();
            }

            // Reflected mirror stroke
            targetCtx.beginPath();
            targetCtx.moveTo(x1_offset, -y1_offset);
            targetCtx.lineTo(x2_offset, -y2_offset);
            targetCtx.stroke();

            if (stroke.lineStyle === 'double') {
                targetCtx.beginPath();
                targetCtx.moveTo(x1_offset + scaledSize, -y1_offset - scaledSize);
                targetCtx.lineTo(x2_offset + scaledSize, -y2_offset - scaledSize);
                targetCtx.stroke();
            }

            targetCtx.restore();
        }

        targetCtx.restore();
        targetCtx.shadowBlur = 0; // Reset shadow
    }

    function redrawCanvas() {
        ctx.fillStyle = canvasThemeSelect.value;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        strokePaths.forEach(stroke => {
            renderStroke(ctx, stroke, PREVIEW_SIZE);
        });
    }

    function stopDraw() {
        if (isDrawing) {
            isDrawing = false;
        }
    }

    canvas.addEventListener('mousedown', startDraw);
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', stopDraw);
    canvas.addEventListener('mouseout', stopDraw);

    canvas.addEventListener('touchstart', (e) => { startDraw(e); e.preventDefault(); });
    canvas.addEventListener('touchmove', (e) => { draw(e); e.preventDefault(); });
    canvas.addEventListener('touchend', (e) => { stopDraw(); e.preventDefault(); });

    undoBtn.addEventListener('click', () => {
        if (strokePaths.length > 0) {
            strokePaths.splice(-5); 
            redrawCanvas();
        }
    });

    clearBtn.addEventListener('click', () => {
        initCanvas();
    });

    downloadBtn.addEventListener('click', () => {
        const resValue = parseInt(exportResolutionSelect.value);
        
        const highResCanvas = document.createElement('canvas');
        highResCanvas.width = resValue;
        highResCanvas.height = resValue;
        const hCtx = highResCanvas.getContext('2d');
        
        hCtx.fillStyle = canvasThemeSelect.value;
        hCtx.fillRect(0, 0, resValue, resValue);
        
        hCtx.imageSmoothingEnabled = true;
        hCtx.imageSmoothingQuality = 'high';

        strokePaths.forEach(stroke => {
            renderStroke(hCtx, stroke, resValue);
        });

        const link = document.createElement('a');
        link.download = `mandala-artwork-${resValue}px.png`;
        link.href = highResCanvas.toDataURL('image/png', 1.0);
        link.click();
    });

    initCanvas();
</script>

</body>
</html>
